# Which OpenAI-compatible backend the agent uses: "ollama" (default, local) or "groq" (cloud)
LLM_PROVIDER=ollama
# Optional model override (defaults: qwen2.5:3b for ollama, llama-3.1-8b-instant for groq)
LLM_MODEL=
# Only needed when LLM_PROVIDER=groq (free key from https://console.groq.com)
GROQ_API_KEY=
